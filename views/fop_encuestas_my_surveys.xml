<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Botón en el home del portal (/my) -->
    <template id="portal_my_surveys"
              name="Show My Surveys"
              customize_show="True"
              inherit_id="portal.portal_my_home"
              priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/fop_encuestas_portal/static/img/survey-doc.png'"/>
                <t t-set="title">My Surveys</t>
                <t t-set="url" t-value="'/my/encuestas'"/>
                <t t-set="text">Access to view your surveys </t>
                <t t-set="count" t-value="surveys_count"/>
                <t t-set="placeholder_count" t-value="'surveys_count'"/>
                <t t-set="config_card" t-value="True"/>
                <t t-set="show_count" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- Listado de encuestas del usuario (/my/encuestas) -->
    <template id="portal_my_surveys_list" name="My Surveys List">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Surveys</t>
            </t>
            <t t-if="not surveys_data">
                <div class="alert alert-info mt-3">
                    <p class="mb-0">No hay encuestas disponibles.</p>
                </div>
            </t>
            <t t-if="surveys_data">
                <div class="table-responsive mt-4">
                    <table class="table table-hover o_portal_my_doc_table">
                        <thead>
                            <tr class="active">
                                <th>Survey</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="surveys_data" t-as="item">
                                <tr>
                                    <td class="align-middle">
                                        <span t-out="item['label']"/>
                                    </td>
                                    <td class="align-middle">
                                        <span t-out="item['date']"/>
                                    </td>
                                    <td class="text-end">
                                        <a t-attf-href="#{item['url']}"
                                           class="btn btn-sm btn-primary"
                                           target="_blank">
                                            <i class="fa fa-file-pdf-o me-1"/>
                                            Ver PDF
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
